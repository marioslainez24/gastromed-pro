# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# desarrollo | pruebas | produccion
GASTROMED_ENV=desarrollo
# Clave larga y aleatoria (mín. 32 caracteres). Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
GASTROMED_SECRET_KEY=
GASTROMED_DATABASE_PATH=instance/gastromed.sqlite3
GASTROMED_FILES_DIR=instance/archivos
# 1 en producción (solo HTTPS)
GASTROMED_COOKIE_SECURE=0
GASTROMED_SESSION_IDLE_MINUTES=30
GASTROMED_SESSION_ABSOLUTE_HOURS=12
# 1 solo si la app está detrás de un proxy inverso de confianza (Caddy/Nginx)
GASTROMED_TRUST_PROXY=0
